{
  "manifest_version": 3,
  "name": "Claude 网络守卫",
  "version": "1.0.0",
  "description": "将 Claude 网页请求交给本机网络守卫，仅在全局代理和美国 IP 检查通过后放行。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "proxy",
    "nativeMessaging",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude 网络守卫"
  },
  "incognito": "not_allowed",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bootstrap_block",
        "enabled": true,
        "path": "bootstrap-rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
